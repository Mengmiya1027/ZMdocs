{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.md"   // 仅当你在 .vue 或 .ts 中 import .md 时才需要，否则可省略
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  }
}